<?xml version="1.0" encoding="utf-8"?>
<!-- act3 -->
<!--background yetbadel akhdher ki approuver a ahmer ki refusé -->
<!-- ملاحظة: استبدل اللاحقة _xx في كل المعرفات بالأحرف الأولى لأحد أعضاء المجموعة -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_douane"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    tools:context=".ResultActivity">
    <!--hedhi code java-->

    <!-- 1 : عنوان صغير (يحدده الكود البرمجي) -->
    <TextView
        android:id="@+id/tv_titre_verdict_xx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.2"
        android:text="VERDICT"
        android:textColor="@color/texte_douane"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 2 : الرمز الكبير الأبيض (✓ أو ✕) يحدده الكود البرمجي -->
    <TextView
        android:id="@+id/tv_icone_xx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="✓"
        android:textColor="@color/texte_douane"
        android:textSize="140sp"
        android:textStyle="bold" />

    <!-- 3 : الرسالة الشخصية (Bon voyage [Nom] أو [Nom] est en état d'arrestation temporelle) -->
    <TextView
        android:id="@+id/tv_message_xx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Verdict en attente"
        android:textColor="@color/texte_douane"
        android:textSize="28sp"
        android:textStyle="bold"
        tools:text="Bon voyage Marty" />

    <!-- 4 : جملة توضيحية صغيرة -->
    <TextView
        android:id="@+id/tv_detail_xx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0.85"
        android:gravity="center"
        android:text="Le poste de douane temporelle a rendu sa décision."
        android:textColor="@color/texte_douane"
        android:textSize="15sp" />

    <!-- 5 : زر مسافر جديد -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_nouveau_xx"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_bouton_blanc_douane"
        android:letterSpacing="0.1"
        android:text="Nouveau voyageur"
        android:textColor="@color/fond_douane"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>