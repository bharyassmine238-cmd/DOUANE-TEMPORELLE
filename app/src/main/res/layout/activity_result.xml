<!--background yetbadel akhdher ki approuver a ahmer ki refusé -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_douane"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    tools:context=".ResultActivity">
    <!-- cc shayma hedhi lil code java-->

    <!-- 1 titre -->
    <TextView
        android:id="@+id/tv_titre_verdict_yb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.2"
        android:text="VERDICT"
        android:textColor="@color/texte_douane"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- les icones croix wla coche -->
    <TextView
        android:id="@+id/tv_icone_yb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="✓"
        android:textColor="@color/texte_douane"
        android:textSize="140sp"
        android:textStyle="bold" />

    <!-- yatlaa kal bon voyage bel esm -->
    <TextView
        android:id="@+id/tv_message_yb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Verdict en attente"
        android:textColor="@color/texte_douane"
        android:textSize="28sp"
        android:textStyle="bold"
        tools:text="Bon voyage fatma" />

    <!-- 4jomla lil tawdhi7   -->
    <TextView
        android:id="@+id/tv_detail_yb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0.85"
        android:gravity="center"
        android:text="Le poste de douane temporelle a rendu sa décision."
        android:textColor="@color/texte_douane"
        android:textSize="15sp" />

    <!-- 5btn new voyageur -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_nouveau_yb"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_bouton_blanc_douane"
        android:letterSpacing="0.1"
        android:text="Nouveau voyageur"
        android:textColor="@color/fond_douane"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>