<?xml version="1.0" encoding="utf-8"?>


<!-- Acitivité 3(yass et fatma) Résultat-->



<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_result_yb"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/fond_voyage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_icone_yb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/tv_titre_yb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DOUANE TEMPORELLE"
            android:textColor="@color/jaune_douane"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/tv_sous_titre_yb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Décision officielle"
            android:textColor="@color/texte_discret_douane"
            android:textSize="13sp"
            android:textStyle="italic" />

        <!-- card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/card_result_yb">

            <TextView
                android:id="@+id/tv_label_voyageur_yb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:text="VOYAGEUR"
                android:textColor="@color/texte_discret_douane"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_nom_yb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texte_douane"
                android:textSize="24sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@color/bordure_douane" />

            <TextView
                android:id="@+id/tv_label_decision_yb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DÉCISION DE LA DOUANE"
                android:textColor="@color/texte_discret_douane"
                android:textSize="12sp"
                android:letterSpacing="0.15" />

            <TextView
                android:id="@+id/tv_verdict_yb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/jaune_douane"
                android:textSize="18sp" />

            <!-- last but not least i wanna   -->
            <TextView
                android:id="@+id/tv_stamp_yb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="8dp"
                android:paddingLeft="28dp"
                android:paddingRight="28dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:rotation="-12"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_retour_yb"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/btn_result_yb"
            android:text="Nouveau voyageur"
            android:textColor="@color/fond_douane"
            android:textStyle="bold"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>