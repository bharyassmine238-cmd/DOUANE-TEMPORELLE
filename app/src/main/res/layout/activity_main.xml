<?xml version="1.0" encoding="utf-8"?>
<!--Activité 1:(fatma) -->

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_douane"
    tools:context=".MainActivity">

    <!-- background
     -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/fond_voyage" />

    <!-- c yassmine 7atit el vidéo fl background -->
    <VideoView
        android:id="@+id/video_portail_yb"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99080D1C" />
    <!-- 3 : ScrollView  tabda thabet wtalaa -->
    <ScrollView
        android:id="@+id/main_yb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <!--ili fih les champs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- titre time travel -->
            <TextView
                android:id="@+id/tv_titre_yb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.08"
                android:text="TIME TRAVEL"
                android:textColor="@color/texte_douane"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sous_titre_yb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="CUSTOMS ●"
                android:textColor="@color/jaune_douane"
                android:textSize="29sp"
                android:textStyle="bold" />

            <View
                android:layout_width="65dp"
                android:layout_height="3dp"
                android:layout_marginTop="12dp"
                android:background="@color/jaune_douane" />

            <TextView
                android:id="@+id/tv_slogan_yb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Poste de douane pour voyageurs du temps"
                android:textColor="@color/texte_discret_douane"
                android:textSize="14sp" />

            <!-- img -->
            <ImageView
                android:id="@+id/img_voyage_yb"
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_champ_douane"
                android:clipToOutline="true"
                android:contentDescription="Image de voyage temporel"
                android:scaleType="centerCrop"
                android:src="@drawable/image_voyage" />

            <!--les champs li bch taamarhom taht etaswira toul -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bgcartedouane"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- nom du voyageur -->
                <TextView
                    android:id="@+id/tv_label_nom_yb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOM DU VOYAGEUR"
                    android:textColor="@color/jaune_douane"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_nom_yb"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_champ_douane"
                    android:hint="Ex : Fatma Ben Salem"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/texte_douane"
                    android:textColorHint="@color/texte_discret_douane" />

                <!-- année de naissanceد -->
                <TextView
                    android:id="@+id/tv_label_naissance_yb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:letterSpacing="0.1"
                    android:text="ANNÉE DE NAISSANCE"
                    android:textColor="@color/jaune_douane"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_naissance_yb"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_champ_douane"
                    android:hint="Ex : 1990"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/texte_douane"
                    android:textColorHint="@color/texte_discret_douane" />

                <!-- année de destination -->
                <TextView
                    android:id="@+id/tv_label_destination_yb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:letterSpacing="0.1"
                    android:text="ANNÉE DE DESTINATION"
                    android:textColor="@color/jaune_douane"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_destination_yb"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_champ_douane"
                    android:hint="Ex : 2050"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/texte_douane"
                    android:textColorHint="@color/texte_discret_douane" />

                <!--raison -->
                <TextView
                    android:id="@+id/tv_label_motif_yb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:letterSpacing="0.1"
                    android:text="MOTIF DU VOYAGE"
                    android:textColor="@color/jaune_douane"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_motif_yb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_champ_douane"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <RadioButton
                        android:id="@+id/rb_tourisme_yb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/jaune_douane"
                        android:checked="true"
                        android:text="Tourisme"
                        android:textColor="@color/texte_douane" />

                    <RadioButton
                        android:id="@+id/rb_modification_yb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/jaune_douane"
                        android:text="Modification du passé"
                        android:textColor="@color/texte_douane" />

                    <RadioButton
                        android:id="@+id/rb_fuite_yb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/jaune_douane"
                        android:text="Fuite"
                        android:textColor="@color/texte_douane" />
                </RadioGroup>

                <!-- btn-->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_inspecter_yb"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_bouton_douane"
                    android:letterSpacing="0.05"
                    android:text="Inspecter le profil"
                    android:textColor="@color/fond_douane"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="20dp"
                android:text="TIME PORTAL • TEMPORAL SECURITY"
                android:textColor="@color/texte_discret_douane"
                android:textSize="10sp"
                android:letterSpacing="0.08" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>