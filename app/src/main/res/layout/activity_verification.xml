<?xml version="1.0" encoding="utf-8"?>
<!-- Activité 2 (yass): Vérification du voyageur temporel -->

<!-- Layout principal horizontal : image à gauche  w les info à droite -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_verification_yb"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@color/fond_douane"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".VerificationActivity">

    <!-- Image gauche : 0.3 -->

    <!-- Partie droite : 0.7 -->
    <!--hne radit teleni afta7 vu que dhohrt yesr gham9a ة -->

    <ImageView
        android:id="@+id/img_passport_yb"
        android:layout_width="0dp"
        android:layout_height="277dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="0.3"
        android:background="@drawable/bg_cadre_photo_douane"
        android:clipToOutline="true"
        android:contentDescription="Image du passeport temporel"
        android:padding="3dp"
        android:scaleType="centerCrop"
        android:src="@drawable/image_voyage" />

    <RelativeLayout
        android:id="@+id/zone_informations_yb"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:background="@drawable/bg_papier_douane"
        android:padding="12dp">

        <!-- Défilement des informations si l'écran est petit -->
        <ScrollView
            android:id="@+id/scroll_verification_yb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/contenu_verification_yb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- titre -->
                <TextView
                    android:id="@+id/tv_titre_verification_yb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CONTRÔLE TEMPOREL"
                    android:textColor="@color/encre_passeport"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sous_titre_verification_yb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.15"
                    android:text="PASSEPORT DU VOYAGEUR"
                    android:textColor="@color/or_passeport"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_pointille_douane"
                    android:layerType="software" />
                <!-- Nom du voyageur -->
                <TextView
                    android:id="@+id/tv_label_nom_verif_yb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NOM DU VOYAGEUR"
                    android:textColor="@color/or_passeport"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_nom_value_yb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="Nom du voyageur"
                    android:textColor="@color/encre_passeport"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <!-- Année de destination -->
                <TextView
                    android:id="@+id/tv_label_destination_verif_yb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="ANNÉE DE DESTINATION"
                    android:textColor="@color/or_passeport"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_destination_value_yb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="2050"
                    android:textColor="@color/encre_passeport"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <!-- àge temporel -->
                <TextView
                    android:id="@+id/tv_label_age_yb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="ÂGE TEMPOREL"
                    android:textColor="@color/or_passeport"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_age_value_yb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="60 ans"
                    android:textColor="@color/encre_passeport"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- lmotif du voyage -->
                <TextView
                    android:id="@+id/tv_label_motif_verif_yb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="MOTIF DU VOYAGE"
                    android:textColor="@color/or_passeport"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_motif_value_yb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="Tourisme"
                    android:textColor="@color/encre_passeport"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Message de contrôle -->
                <!-- cc yas c'est fatma badelt haje mch khedmet en faite zedt aaleha juste njared fi zina kil ticket ou passport nbdlo lphoto nrodouha taa abed  -->
                <TextView
                    android:id="@+id/tv_message_verification_yb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bgcartedouane"
                    android:padding="10dp"
                    android:text="Veuillez examiner le profil du voyageur."
                    android:textColor="@color/texte_douane"
                    android:textSize="13sp" />
                <!-- ahla bik fatima rabi yehdik karna melowel mais pas grave sinon andi un ptit problm mahouch kaad yafichili ki nji naaml commit ?? -->




                <!-- hedha kal ligne mtaa les tickets fil aadi mais momken nfaskho wla tnjm tfskho -->
                <TextView
                    android:id="@+id/tv_mrz_yb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="monospace"
                    android:maxLines="2"
                    android:text="P&lt;TUN&lt;&lt;VOYAGEUR&lt;&lt;&lt;&lt;&lt;&lt;&lt;\n2050&lt;&lt;TOURISME&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;"
                    android:textColor="@color/encre_passeport"
                    android:textSize="10sp" />

                <!-- aka lkhat kbal les btn  -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_pointille_douane"
                    android:layerType="software" />

                <!--  bouton approuver -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_approuver_yb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_bouton_douane"
                    android:text="Approuver le saut temporel"
                    android:textColor="@color/fond_douane"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- btn refus -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_refuser_yb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_champ_douane"
                    android:text="Refuser (Risque de paradoxe)"
                    android:textColor="@color/texte_douane"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>

    </RelativeLayout>

</LinearLayout>
